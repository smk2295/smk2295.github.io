---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign url_beginning = page.url | slice: 0, 6 %}

{% if page.series %}
  {% assign series_posts = site.posts | where: 'series', page.series | sort: 'date' %}
  {% for p in series_posts %}
    {% if p.url == page.url %}{% assign series_index = forloop.index %}{% endif %}
  {% endfor %}
{% endif %}

<div class="post post-single">
  <header class="post-header post-hero">
    {% if categories != '' or page.series %}
      <p class="post-eyebrow">
        {% if page.series %}
          <span class="series-badge">{{ page.series }} · {{ series_index }}/{{ series_posts.size }}</span>
        {% endif %}
        {% for category in page.categories %}
          {% if url_beginning == '/blog/' %}
            <a href="{{ category | slugify | prepend: '/blog/category/' | prepend: site.baseurl}}">{{ category | replace: '-', ' ' }}</a>
          {% else %}
            {{ category | replace: '-', ' ' }}
          {% endif %}
          {% unless forloop.last %}&middot;{% endunless %}
        {% endfor %}
      </p>
    {% endif %}
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-lead">{{ page.description }}</p>
    {% endif %}
    <div class="post-byline">
      <span class="post-meta">
        <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%B %-d, %Y' }}</time>
        {% if page.author %}&middot; {{ page.author }}{% endif %}
        {% if page.last_updated %}&middot; Updated {{ page.last_updated | date: '%B %-d, %Y' }}{% endif %}
        {% if page.meta %}&middot; {{ page.meta }}{% endif %}
      </span>
      {% if tags != '' %}
        <span class="post-tags">
          {% for tag in page.tags %}
            {% if url_beginning == '/blog/' %}
              <a href="{{ tag | slugify | prepend: '/blog/tag/' | prepend: site.baseurl}}">#{{ tag }}</a>
            {% else %}
              <span>#{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </span>
      {% endif %}
    </div>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.series and series_posts.size > 1 %}
    <nav class="series-nav" aria-label="Series">
      <div class="series-nav-head">
        <span class="series-name">{{ page.series }}</span>
        <span class="label">Series · {{ series_posts.size }} posts</span>
      </div>
      <ol>
        {% for p in series_posts %}
          <li>
            {% if p.url == page.url %}
              <span class="current"><span class="num">{{ forloop.index }}</span>{{ p.title }}</span>
            {% else %}
              <a href="{{ p.url | relative_url }}"><span class="num">{{ forloop.index }}</span>{{ p.title }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    </nav>
  {% endif %}

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
